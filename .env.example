# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Optional: Supabase Service Role Key (Loaded ONLY on secure server/backend operations, never sent to client)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Direct PostgreSQL Connection String for applying migrations automatically
DATABASE_URL=

# App Security Settings
APP_SECRET_KEY=college-complaint-box-production-secure-key-2026
MAX_FAILED_LOGIN_ATTEMPTS=5
STORAGE_BUCKET=complaint-attachments
